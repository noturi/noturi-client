{
  "expo": {
    "name": "Noturi",
    "slug": "noturi-client",
    "version": "1.5.1",
    "owner": "dokimion24",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "noturiclient",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.noturi.app",
      "buildNumber": "3",
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "3JAT5MMB44",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "ko": "./locales/ko.json"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.noturi.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-noturi-widget",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Noturi가 Face ID로 저장된 정보를 보호하도록 허용합니다."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1037765933934-3v8f0acqqjkk2mtv4hsaqfpvvr2c8bsc"
        }
      ],
      [
        "expo-apple-authentication"
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      "expo-image",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1469043-19f5-4185-9ada-7f09a682c8a5",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "NoturiWidget",
                  "bundleIdentifier": "com.noturi.app.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.noturi.app"
                    ],
                    "keychain-access-groups": [
                      "$(AppIdentifierPrefix)com.noturi.app.shared"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
